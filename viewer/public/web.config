<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS has no built-in MIME type mapping for .md - without this, IIS
  returns 404 for every lenses/*.md, sagas/*.md, and appendices/*.md
  request even though the files are physically present, because its
  static-file handler refuses to serve an unregistered extension.
  Found and fixed by testing a real IIS deployment
  (Deploy-CoyoteWiki.ps1), not assumed from documentation.

  Shipped as part of the deployable artifact (copied into dist/ by
  build.mjs) rather than a one-off change to this machine's IIS
  config, so it travels with the site to any other IIS host too.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
    </staticContent>
  </system.webServer>
</configuration>
